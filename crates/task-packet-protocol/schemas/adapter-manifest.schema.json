{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adapter-manifest.schema.json",
  "title": "Task Packet Protocol adapter manifest",
  "description": "Capabilities and compatibility advertised by a project, orchestrator, agent, context, or artifact adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_kind",
    "display_name",
    "version",
    "protocol_versions",
    "capabilities",
    "configuration"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "adapter_kind": {
      "type": "string",
      "enum": [
        "project",
        "orchestrator",
        "agent",
        "context_provider",
        "artifact_store"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "configuration": {
      "type": "object",
      "description": "Adapter-specific configuration or a JSON Schema describing it."
    },
    "metadata": {
      "type": "object"
    }
  }
}
